import java.util.*;

class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {
        // Only rows having reserved seats need to be processed.
        Map<Integer, Integer> map = new HashMap<>();

        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            // Only seats 2 to 9 can affect the three possible groups.
            if (col >= 2 && col <= 9) {
                int mask = map.getOrDefault(row, 0);
                mask |= (1 << col);
                map.put(row, mask);
            }
        }

        // Every completely empty row can accommodate 2 groups:
        // [2,3,4,5] and [6,7,8,9]
        int answer = (n - map.size()) * 2;

        // Masks for the three possible blocks
        int left  = (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5);
        int middle = (1 << 4) | (1 << 5) | (1 << 6) | (1 << 7);
        int right = (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9);

        for (int mask : map.values()) {

            boolean canLeft = (mask & left) == 0;
            boolean canMiddle = (mask & middle) == 0;
            boolean canRight = (mask & right) == 0;

            if (canLeft && canRight) {
                // Two non-overlapping groups
                answer += 2;
            } else if (canLeft || canMiddle || canRight) {
                // At least one group can be seated
                answer += 1;
            }
        }

        return answer;
    }
}