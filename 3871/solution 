class Solution {
    public int countCommas(int n, int m) {
        int ans = 0;

        // Pattern: Digit length determines number of commas
        for (int i = n; i <= m; i++) {
            if (i >= 1000) ans++;
            if (i >= 1000000) ans++;
            if (i >= 1000000000) ans++;
        }

        return ans;
    }
}
