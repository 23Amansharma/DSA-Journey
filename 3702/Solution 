int longestSubsequence(int* nums, int numsSize) {
    int xor = 0;

    for (int i = 0; i < numsSize; i++)
        xor ^= nums[i];

    if (xor != 0)
        return numsSize;

    // Total XOR is 0, remove one non-zero element.
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != 0)
            return numsSize - 1;
    }

    return 0;
}